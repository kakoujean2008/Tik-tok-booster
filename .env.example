# Clé API secrète Chariow (Développeur > API Keys, commence par sk_live_)
CHARIOW_API_KEY=

# JSONBin
JSONBIN_BIN_ID=6a693969da38895dfe9d91fd
JSONBIN_MASTER_KEY=

# Clé API Grok / x.ai (console.x.ai)
GROK_API_KEY=

# URL de ton site une fois en ligne (sans slash à la fin)
# Ex : https://tiktok-booster.vercel.app
SITE_URL=
